# Optic V1 Backend — Environment Configuration
# Copy to .env and adjust as needed.
# The start.sh script sources this file before starting the server.

# Host and port for the V1 FastAPI server
OPTIC_HOST=0.0.0.0
OPTIC_PORT=3003

# Python interpreter (default: python3)
# OPTIC_PYTHON=python3.12

# Database path (relative to backend/ or absolute)
# Defaults to .optic/v1.db in the backend directory
# OPTIC_DB_PATH=.optic/v1.db

# ── DeepSeek (opt-in, fully optional — system works offline without it) ──
# DEEPSEEK_API_KEY=sk-your-key-here
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
